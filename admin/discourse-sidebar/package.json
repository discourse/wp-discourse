{
	"name": "discourse-sidebar",
	"version": "1.0.0",
	"description": "Adds a Discourse Sidebar to the Block Editor",
	"main": "build/index.js",
	"scripts": {
		"dev": "nodemon --watch src --exec 'wp-scripts start'",
		"build": "wp-scripts build",
		"format:css": "wp-scripts lint-style --fix",
		"format:js": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"start": "wp-scripts start"
	},
	"author": "Discourse",
	"license": "GPL",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^37.1.0",
		"nodemon": "3.1.10"
	},
	"overrides": {
		"copy-webpack-plugin": {
			"serialize-javascript": "^7.0.5"
		},
		"js-yaml@>=5.0.0 <5.4.1": "^5.4.1",
		"katex@<0.18.2": "^0.18.2",
		"minimatch@>=7.0.0 <11.0.1": "^11.0.1",
		"smol-toml@<1.9.0": "^1.9.0"
	}
}
